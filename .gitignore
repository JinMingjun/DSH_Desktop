# ═══════════════════════════════════════════════════════════════
# DSH_Desktop / .gitignore
#
# 桌面端源码、assets/、plugins/ 和 tests/ 应当入库。
# 仅排除本地数据、密钥、浏览器资料、构建产物及编辑器临时文件。
# ═══════════════════════════════════════════════════════════════


# ── 1. DSH 运行时数据（DSH_HOME）───────────────────────────────
# DSH_HOME 下保存 sessions 对话历史、attachments 附件、profiles
# 插件配置、storages 会话索引、settings.yaml 个人设置，以及
# .credentials.yaml（含 API key）。
#
# DSH_HOME 通常在仓库外；以下根目录规则防止意外拷入。
/Memory/

# DSH_HOME 的各个组成部分，单独列出以防它们在别处出现
/sessions/
/attachments/
/storages/
/profiles/

# 个人配置与凭据
.credentials.yaml
.credentials.*
/.anonymous-user-id
/settings.yaml
/workspace.json
/files-v3.json
# 环境变量文件可能包含 DEEPSEEK_API_KEY；示例模板允许入库。
**/.env
**/.env.*
!**/.env.example


# ── 2. WebView2 浏览器用户配置 ─────────────────────────────────
# 含 Cookie、保存的登录数据（Login Data）、浏览历史、自动填充，
# 属隐私数据，绝不入库。
# 注意：历史上 publish/ 被整目录入库时，就是把这些一起带上去的。
*.WebView2/
EBWebView/


# ── 3. 构建与发布产物 ──────────────────────────────────────────
# 均可由 dotnet 重建，不属于"内容"，没必要入库。
# 其中 publish/ 是桌面端实际运行的目录，内含 WebView2 profile。
/bin/
/obj/
/publish/


# ── 4. 编辑器 / IDE / 临时文件 ─────────────────────────────────
/.vs/
/.idea/
*.user
*.suo
/.Rhistory
/.RData
.Rproj.user


# ── 5. 本地排查临时文件 ────────────────────────────────────────
/_probe-session.jsonl
