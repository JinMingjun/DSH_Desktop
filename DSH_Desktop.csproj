<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DSH_Desktop</RootNamespace>
    <AssemblyName>DSH_Desktop</AssemblyName>
    <ApplicationIcon>assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>DeepSeek DSH</AssemblyTitle>
    <Product>DeepSeek DSH</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 SDK（WPF 控件 + Core） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <!-- 启动页随构建复制到输出目录 -->
    <None Include="assets\Splash.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\desktop-bootstrap.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="plugins\**\lib\*.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
