{
  "name": "dsh-wallpaper",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Web UI 全局壁纸插件：右侧悬浮按钮展开侧栏，选择图片作为整个 UI 的背景，支持模糊 / 亮度 / 饱和度 / 对比度 / 透明度调节（滑杆 + 手动输入）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT"
}
