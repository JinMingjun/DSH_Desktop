{
  "name": "dsh-attachments",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 桌面附件选择器：原生多选窗口、图片附件和文件引用卡片。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-reference"]
    }
  },
  "license": "MIT"
}
